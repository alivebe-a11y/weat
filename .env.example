# Copy to .env and fill in. .env is gitignored (it holds a secret).

# --- GitHub mirror (keeps the Excel/raw-CSV URL alive) ---
# Leave blank to run fully local with no mirroring.
# Fine-grained PAT with "Contents: read and write" on just this repo.
GITHUB_TOKEN=
GITHUB_REPO=alivebe-a11y/weat
GITHUB_BRANCH=claude/funny-fermi-aHqTB

# --- Scheduling ---
FETCH_INTERVAL_MIN=30   # forecast cadence (minutes)
VERIFY_HOUR=6           # local hour to pull ERA5 actuals + rescore
